[
    {
        "id": 1,
        "priority": 100,
        "action": {
            "type": "allow"
        },
        "condition": {
            "regexFilter": "^https://(raw|media)\\.githubusercontent\\.com/[^?#]*[?&]download=true",
            "resourceTypes": [
                "main_frame"
            ]
        }
    },
    {
        "id": 2,
        "priority": 10,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "Content-Disposition",
                    "operation": "remove"
                }
            ]
        },
        "condition": {
            "regexFilter": "^https://(raw|media)\\.githubusercontent\\.com/[^?#]*(\\?[^#]*)?$",
            "resourceTypes": [
                "main_frame"
            ]
        }
    },
    {
        "id": 3,
        "priority": 20,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "Content-Disposition",
                    "operation": "remove"
                },
                {
                    "header": "Content-Type",
                    "operation": "set",
                    "value": "video/mp4"
                }
            ]
        },
        "condition": {
            "regexFilter": "^https://(raw|media)\\.githubusercontent\\.com/[^?#]*\\.mp4(\\?[^#]*)?$",
            "resourceTypes": [
                "main_frame",
                "media"
            ]
        }
    }
]
