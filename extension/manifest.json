{
  "manifest_version": 3,
  "name": "GitHub Raw Previewer",
  "version": "2026.3.6",
  "description": "Preview videos, audio, Office docs, fonts and BMP images inline on GitHub. No forced downloads, no servers, no tracking.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://media.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "formats.js",
        "selectors.js",
        "content.js"
      ],
      "css": [
        "injection.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer-font.html",
        "viewer-font.css",
        "viewer-font.js",
        "viewer-media.html",
        "viewer-media.js",
        "viewer-office.html",
        "viewer-office.js"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Raw Previewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
